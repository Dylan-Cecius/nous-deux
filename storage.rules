rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(coupleId) {
      return request.auth != null &&
        !firestore.exists(/databases/(default)/documents/accountDeletions/$(request.auth.uid)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
    }
    function writable(coupleId) {
      return member(coupleId) && !('deletionLock' in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data);
    }
    match /couples/{coupleId}/photos/{file} { allow read: if member(coupleId); }
    match /couples/{coupleId}/photos/{uid}/{file} {
      allow read: if member(coupleId);
      allow create: if resource == null && writable(coupleId) && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg','image/png','image/webp'];
      allow delete: if writable(coupleId) && request.auth.uid == uid;
      allow update: if false;
    }
  }
}

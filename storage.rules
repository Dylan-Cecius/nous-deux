rules_version = '2';

// Photos du couple (souvenirs, photo de la carte compteur) : réservées aux deux membres.
service firebase.storage {
  match /b/{bucket}/o {
    match /couples/{coupleId}/photos/{file} {
      function isMember() {
        return request.auth != null &&
          request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.members;
      }
      allow read: if isMember();
      // Images uniquement, 10 Mo maximum.
      allow write: if isMember() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isMember();
    }
  }
}

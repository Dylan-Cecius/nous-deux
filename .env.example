# Copie ce fichier en « .env » et remplis-le avec la config de ton app Web Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Config).
# Ces valeurs ne sont pas secrètes : elles sont intégrées dans l'app, la sécurité vient de firestore.rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mettre true uniquement après activation et vérification de chaque service serveur.
EXPO_PUBLIC_ASSISTANT_ENABLED=false
EXPO_PUBLIC_PLACES_ENABLED=false

# Achats natifs : activer uniquement après configuration des stores et du serveur.
# Clés SDK publiques RevenueCat (jamais la clé REST secrète).
EXPO_PUBLIC_BILLING_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Informations publiques obligatoires avant la soumission aux stores.
EXPO_PUBLIC_LEGAL_ENTITY=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

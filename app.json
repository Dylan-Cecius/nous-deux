{
  "expo": {
    "name": "Nous Deux",
    "slug": "nous-deux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nousdeux",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cecius.nousdeux",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Nous Deux transforme ta voix en texte pour ajouter restos, horaires et envies.",
        "NSMicrophoneUsageDescription": "Nous Deux utilise le micro quand tu dictes une demande à l’assistant."
      }
    },
    "android": {
      "package": "com.cecius.nousdeux",
      "adaptiveIcon": {
        "backgroundColor": "#2A1420",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A1420",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nous Deux utilise le micro quand tu dictes une demande à l’assistant.",
          "speechRecognitionPermission": "Nous Deux transforme ta voix en texte pour ajouter restos, horaires et envies."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nous Deux accède à tes photos pour vos souvenirs, la photo de couple et l’import de planning.",
          "cameraPermission": "Nous Deux utilise l’appareil photo pour photographier ton planning ou un souvenir."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8385A"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f8a2b4c-ade1-46c7-ae58-cc3181cc325a"
      }
    },
    "owner": "dylancecius"
  }
}

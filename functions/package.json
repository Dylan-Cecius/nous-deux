{
  "name": "nous-deux-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test:guard": "node --test test/emulator-guard.test.cjs",
    "test": "npm run test:guard && node --test --test-concurrency=1 test/security.test.cjs",
    "migrate:security": "npm run build && node scripts/migrate-security.cjs",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^14.12.0",
    "typescript": "~5.9.3"
  }
}
